# Environment variables for Shirt Store
# Copy to .env.local and fill in your values

# MongoDB (use Atlas free tier)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shirtstore?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-use-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Email (for NextAuth)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Razorpay (India payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxx

# Direct UPI / Google Pay collection (no gateway — payments require manual admin confirmation)
NEXT_PUBLIC_UPI_ID=yourbusiness@oksbi
NEXT_PUBLIC_UPI_PAYEE_NAME=VCHUKI Fashion Private Limited

# Google reCAPTCHA v3 (checkout bot protection) — get keys at google.com/recaptcha/admin
# Checkout works normally without these; they're only enforced once both are set.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Stripe (international)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Shipping (placeholder)
SHIPPING_RATE_FIXED=50

# Production
NODE_ENV=development

# Brevo Email
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=aeb72d001@smtp-brevo.com
ADMIN_EMAIL=akshayneriya2001@gmail.com
