# Environment variables for Shirt Store
# Copy to .env.local and fill in your values

# MongoDB (use Atlas free tier)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shirtstore?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-use-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Email (for NextAuth)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Razorpay (India payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxx

# Stripe (international)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Shipping (placeholder)
SHIPPING_RATE_FIXED=50

# Production
NODE_ENV=development
