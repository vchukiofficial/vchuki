{
  "expo": {
    "name": "VCHUKI",
    "slug": "vchuki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vchuki",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.vchuki.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan stock labels and take review photos.",
        "NSPhotoLibraryUsageDescription": "Attach photos to your product reviews.",
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Unlock VCHUKI with Face ID."
      },
      "associatedDomains": [
        "applinks:vchuki.com",
        "applinks:www.vchuki.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vchuki.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vchuki.com",
              "pathPrefix": "/product/"
            },
            {
              "scheme": "https",
              "host": "vchuki.com",
              "pathPrefix": "/products/"
            },
            {
              "scheme": "https",
              "host": "vchuki.com",
              "pathPrefix": "/shirts"
            },
            {
              "scheme": "https",
              "host": "vchuki.com",
              "pathPrefix": "/blog"
            },
            {
              "scheme": "https",
              "host": "www.vchuki.com",
              "pathPrefix": "/product/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to your product reviews.",
          "cameraPermission": "Take photos for your product reviews."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan stock labels and take review photos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A09",
          "image": "./assets/images/logo-mark-light.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock VCHUKI with Face ID."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save product photos to your gallery.",
          "savePhotosPermission": "Save product photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0A09",
    "extra": {
      "apiUrl": "https://vchuki.com"
    }
  }
}